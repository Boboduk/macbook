<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The app is not sandboxed: CGEventTap (media keys), Accessibility checks and
	DisplayServices are unavailable inside the App Sandbox.

	With the Hardened Runtime enabled, sending Apple Events (Music / Spotify
	control) requires this entitlement in addition to the user's consent.
	-->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
